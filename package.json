{
  "name": "supermaze",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w @supermaze/client",
    "dev:server": "npm run dev -w @supermaze/server",
    "build:client": "npm run build -w @supermaze/client",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate-maps": "npm start -w @supermaze/map-validator"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
